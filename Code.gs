/**
 * Entry point untuk Web App Google Apps Script
 */
function doGet(e) {
  var template = HtmlService.createTemplateFromFile('Index');
  template.runtimeMode = 'production';
  return template
    .evaluate()
    .setTitle('Dashboard Monitoring & Evaluasi BJDPL/MDPL - CRS Area Gorontalo')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/**
 * Inisialisasi struktur sheet database
 */
function setupDatabase() {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var requiredSheets = ['Kemarin', 'Hari ini', 'Osl Total', 'Users', 'AuditLog'];
    requiredSheets.forEach(function(sheetName) {
      if (!ss.getSheetByName(sheetName)) ss.insertSheet(sheetName);
    });
    logAction('System', 'SETUP_DATABASE', 'Inisialisasi database dijalankan');
    return { success: true, message: 'Database setup selesai. Sheet siap digunakan.' };
  } catch (err) {
    return { success: false, message: 'Error setup database: ' + err.message };
  }
}

/**
 * Parsing angka aman dari format teks / spreadsheet (format Indonesia maupun angka murni)
 * Contoh: 14610000, "345.524.245.899", "Rp 14.610.000"
 */
function parseNum(val) {
  if (val === null || val === undefined || val === '') return 0;
  if (typeof val === 'number') return val;
  var s = String(val).trim().replace(/Rp|\s/g, '');
  var dotCount = (s.match(/\./g) || []).length;
  if (dotCount > 1 || (dotCount === 1 && s.length - s.lastIndexOf('.') === 4)) {
    s = s.replace(/\./g, '');
  } else if (s.indexOf(',') !== -1) {
    s = s.replace(/\./g, '').replace(',', '.');
  }
  var n = parseFloat(s);
  return isNaN(n) ? 0 : n;
}

/**
 * Membersihkan kode awalan pada nama Area/Cabang/Unit/Produk
 * Contoh: "00716:AREA GORONTALO" -> "AREA GORONTALO", "01. GADAI KCA" -> "GADAI KCA"
 */
function cleanCode(val) {
  if (!val) return '';
  var s = String(val).trim();
  if (s.indexOf(':') !== -1) {
    var parts = s.split(':');
    if (parts.length > 1 && parts[0].replace(/\s/g, '').length <= 8) {
      return parts.slice(1).join(':').trim().toUpperCase();
    }
  }
  var matchNumDot = s.match(/^\d+[\.\s]+(.*)$/);
  if (matchNumDot && matchNumDot[1]) {
    return matchNumDot[1].trim().toUpperCase();
  }
  return s.toUpperCase();
}

/**
 * Menentukan indeks kelompok umur (1-7) dari label UMUR PERIODE secara akurat
 * 1: 1 sd 15 Hari
 * 2: 16 sd 30 Hari
 * 3: 31 sd 45 Hari
 * 4: 46 sd 60 Hari
 * 5: 61 sd 75 Hari
 * 6: 76 sd 90 Hari
 * 7: Lebih dari 90 Hari / >90 Hari
 */
function getBucketIndex(val) {
  if (!val) return 0;
  var s = String(val).toLowerCase().replace(/\s+/g, ' ').trim();
  var norm = s.replace(/s\.d\.|s\.d|s\/d|\bsd\b|sampai/g, '-').replace(/\s*-\s*/g, '-');

  if (norm.indexOf('1-15') !== -1 || s.indexOf('1 :') !== -1 || s.indexOf('1:') !== -1) return 1;
  if (norm.indexOf('16-30') !== -1 || s.indexOf('2 :') !== -1 || s.indexOf('2:') !== -1) return 2;
  if (norm.indexOf('31-45') !== -1 || s.indexOf('3 :') !== -1 || s.indexOf('3:') !== -1) return 3;
  if (norm.indexOf('46-60') !== -1 || s.indexOf('4 :') !== -1 || s.indexOf('4:') !== -1) return 4;
  if (norm.indexOf('61-75') !== -1 || s.indexOf('5 :') !== -1 || s.indexOf('5:') !== -1) return 5;
  if (norm.indexOf('76-90') !== -1 || s.indexOf('6 :') !== -1 || s.indexOf('6:') !== -1) return 6;
  if (s.indexOf('lebih') !== -1 || s.indexOf('diatas') !== -1 || s.indexOf('di atas') !== -1 ||
      s.indexOf('> 90') !== -1 || s.indexOf('>90') !== -1 || norm.indexOf('>90') !== -1 ||
      norm.indexOf('91') !== -1 || s.indexOf('7 :') !== -1 || s.indexOf('7:') !== -1) return 7;
  return 0;
}

/**
 * Mencari sheet secara fleksibel (case-insensitive & whitespace trimmed)
 */
function getSheetCaseInsensitive(ss, targetName) {
  var sheet = ss.getSheetByName(targetName);
  if (sheet) return sheet;
  var sheets = ss.getSheets();
  for (var i = 0; i < sheets.length; i++) {
    if (sheets[i].getName().trim().toUpperCase() === targetName.trim().toUpperCase()) {
      return sheets[i];
    }
  }
  return null;
}

/**
 * Deteksi kolom spreadsheet secara dinamis berdasarkan baris header
 * Sesuai screenshot:
 * Col A  (0)  = TANGGAL
 * Col B  (1)  = UMUR PERIODE
 * Col K  (10) = BJDPL BLNINI (Nominal saldo)
 * Col R  (17) = NEW AREA
 * Col S  (18) = NEW CABANG
 * Col T  (19) = NEW OUTLET
 * Col U  (20) = NEW PRODUCT
 */
function detectColumns(headerRow) {
  var cols = {
    colTanggal: 0,
    colUmur: 1,
    colNominal: 10,
    colArea: 17,
    colCabang: 18,
    colUnit: 19,
    colProduk: 20
  };

  if (!headerRow) return cols;

  for (var c = 0; c < headerRow.length; c++) {
    var h = String(headerRow[c] || '').trim().toUpperCase();
    if (h === 'TANGGAL') cols.colTanggal = c;
    if (h === 'UMUR PERIODE' || h === 'UMUR') cols.colUmur = c;
    if (h === 'BJDPL BLNINI' || h === 'BJDPL' || h === 'RLISIN' || h === 'NOMINAL') cols.colNominal = c;
    if (h === 'NEW AREA') cols.colArea = c;
    else if (cols.colArea === 17 && h === 'AREA') cols.colArea = c;
    if (h === 'NEW CABANG') cols.colCabang = c;
    else if (cols.colCabang === 18 && h === 'CABANG') cols.colCabang = c;
    if (h === 'NEW OUTLET' || h === 'NEW UNIT') cols.colUnit = c;
    else if (cols.colUnit === 19 && (h === 'UNIT' || h === 'OUTLET')) cols.colUnit = c;
    if (h === 'NEW PRODUCT' || h === 'NEW PRODUK') cols.colProduk = c;
    else if (cols.colProduk === 20 && (h === 'PRODUCT' || h === 'PRODUK')) cols.colProduk = c;
  }
  return cols;
}

// Daftar 9 Cabang resmi Area Gorontalo untuk validasi silang
var CABANG_GORONTALO_REF = [
  'CP LIMBOTO', 'CP LUWUK', 'CP MOLINOW', 'CP KOTAMOBAGU',
  'CPS DATOE BINANGKANG', 'CP GORONTALO UTARA', 'CP GORONTALO SENTRAL',
  'CPS GORONTALO', 'CP GORONTALO SELATAN'
];

function isGorontaloBranch(cabangStr) {
  if (!cabangStr) return false;
  var c = cabangStr.toUpperCase();
  for (var i = 0; i < CABANG_GORONTALO_REF.length; i++) {
    var ref = CABANG_GORONTALO_REF[i];
    if (c === ref || c.indexOf(ref) !== -1 || ref.indexOf(c) !== -1) return true;
  }
  return false;
}

/**
 * FUNGSI UTAMA: Fetch & Agregasi Data Dashboard
 * Menyingkronkan data dari:
 * 1. Sheet "Hari ini" -> Kolom K (BJDPL BLNINI) untuk data hari ini
 * 2. Sheet "Kemarin" -> Kolom K (BJDPL BLNINI) untuk data kemarin
 * 3. Sheet "Osl Total" -> Kolom A (UNIT KERJA) & B (OSL TOTAL)
 */
function fetchDashboardData() {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    if (!ss) return { success: false, message: 'Active Spreadsheet tidak ditemukan.' };

    var sheetHariIni = getSheetCaseInsensitive(ss, 'Hari ini');
    var sheetKemarin = getSheetCaseInsensitive(ss, 'Kemarin');
    if (!sheetHariIni && !sheetKemarin) sheetHariIni = ss.getSheets()[0];

    var rowsHariIni = sheetHariIni ? sheetHariIni.getDataRange().getValues() : [];
    var rowsKemarin = sheetKemarin ? sheetKemarin.getDataRange().getValues() : [];

    if (rowsHariIni.length <= 1 && rowsKemarin.length <= 1) {
      return {
        success: true,
        lastUpdated: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd MMM yyyy, HH:mm:ss'),
        records: [], osl: [],
        message: 'Sheet data kosong atau hanya header.'
      };
    }

    // Periksa apakah terdapat baris Area Gorontalo di sheet
    var hasGorontaloHariIni = false;
    if (rowsHariIni.length > 1) {
      var cDet = detectColumns(rowsHariIni[0]);
      for (var checkI = 1; checkI < rowsHariIni.length; checkI++) {
        var aStr = cleanCode(rowsHariIni[checkI][cDet.colArea]);
        var cStr = cleanCode(rowsHariIni[checkI][cDet.colCabang]);
        if (aStr.indexOf('GORONTALO') !== -1 || isGorontaloBranch(cStr)) {
          hasGorontaloHariIni = true;
          break;
        }
      }
    }

    var hasGorontaloKemarin = false;
    if (rowsKemarin.length > 1) {
      var cDetK = detectColumns(rowsKemarin[0]);
      for (var checkK = 1; checkK < rowsKemarin.length; checkK++) {
        var aStrK = cleanCode(rowsKemarin[checkK][cDetK.colArea]);
        var cStrK = cleanCode(rowsKemarin[checkK][cDetK.colCabang]);
        if (aStrK.indexOf('GORONTALO') !== -1 || isGorontaloBranch(cStrK)) {
          hasGorontaloKemarin = true;
          break;
        }
      }
    }

    var filterGorontaloOnly = (hasGorontaloHariIni || hasGorontaloKemarin);

    var aggregated = {};

    // 1. PROSES SHEET "Hari ini"
    if (rowsHariIni.length > 1) {
      var colsH = detectColumns(rowsHariIni[0]);
      for (var i = 1; i < rowsHariIni.length; i++) {
        var row = rowsHariIni[i];
        if (!row || row.length <= colsH.colUmur) continue;

        var areaVal = cleanCode(row[colsH.colArea]) || 'AREA GORONTALO';
        var cabangVal = cleanCode(row[colsH.colCabang]) || 'CABANG UTAMA';
        var unitVal = cleanCode(row[colsH.colUnit]) || cabangVal;
        var produkVal = cleanCode(row[colsH.colProduk]) || 'UMUM';

        // Filter Area Gorontalo jika terdapat data Gorontalo di sheet
        if (filterGorontaloOnly) {
          if (areaVal.indexOf('GORONTALO') === -1 && !isGorontaloBranch(cabangVal)) continue;
        }

        var bucket = getBucketIndex(row[colsH.colUmur]);
        if (bucket === 0) continue;

        var nomHariIni = parseNum(row[colsH.colNominal]);

        var key = areaVal + '|||' + cabangVal + '|||' + unitVal + '|||' + produkVal;
        if (!aggregated[key]) {
          aggregated[key] = {
            area: areaVal, cabang: cabangVal, unit: unitVal, produk: produkVal,
            u1_hariIni: 0, u2_hariIni: 0, u3_hariIni: 0, u4_hariIni: 0,
            u5_hariIni: 0, u6_hariIni: 0, u7_hariIni: 0, total_hariIni: 0,
            u1_kemarin: 0, u2_kemarin: 0, u3_kemarin: 0, u4_kemarin: 0,
            u5_kemarin: 0, u6_kemarin: 0, u7_kemarin: 0, total_kemarin: 0
          };
        }
        aggregated[key]['u' + bucket + '_hariIni'] += nomHariIni;
        aggregated[key].total_hariIni += nomHariIni;
      }
    }

    // 2. PROSES SHEET "Kemarin"
    if (rowsKemarin.length > 1) {
      var colsK = detectColumns(rowsKemarin[0]);
      for (var j = 1; j < rowsKemarin.length; j++) {
        var rowK = rowsKemarin[j];
        if (!rowK || rowK.length <= colsK.colUmur) continue;

        var areaValK = cleanCode(rowK[colsK.colArea]) || 'AREA GORONTALO';
        var cabangValK = cleanCode(rowK[colsK.colCabang]) || 'CABANG UTAMA';
        var unitValK = cleanCode(rowK[colsK.colUnit]) || cabangValK;
        var produkValK = cleanCode(rowK[colsK.colProduk]) || 'UMUM';

        if (filterGorontaloOnly) {
          if (areaValK.indexOf('GORONTALO') === -1 && !isGorontaloBranch(cabangValK)) continue;
        }

        var bucketK = getBucketIndex(rowK[colsK.colUmur]);
        if (bucketK === 0) continue;

        var nomKemarin = parseNum(rowK[colsK.colNominal]);

        var keyK = areaValK + '|||' + cabangValK + '|||' + unitValK + '|||' + produkValK;
        if (!aggregated[keyK]) {
          aggregated[keyK] = {
            area: areaValK, cabang: cabangValK, unit: unitValK, produk: produkValK,
            u1_hariIni: 0, u2_hariIni: 0, u3_hariIni: 0, u4_hariIni: 0,
            u5_hariIni: 0, u6_hariIni: 0, u7_hariIni: 0, total_hariIni: 0,
            u1_kemarin: 0, u2_kemarin: 0, u3_kemarin: 0, u4_kemarin: 0,
            u5_kemarin: 0, u6_kemarin: 0, u7_kemarin: 0, total_kemarin: 0
          };
        }
        aggregated[keyK]['u' + bucketK + '_kemarin'] += nomKemarin;
        aggregated[keyK].total_kemarin += nomKemarin;
      }
    }

    // 3. PROSES SHEET "Osl Total"
    // Sesuai screenshot: Col A = UNIT KERJA (nama cabang), Col B = OSL TOTAL
    var oslData = [];
    var sheetOsl = getSheetCaseInsensitive(ss, 'Osl Total');
    if (!sheetOsl) {
      var allSheets = ss.getSheets();
      for (var sIdx = 0; sIdx < allSheets.length; sIdx++) {
        if (allSheets[sIdx].getName().toUpperCase().indexOf('OSL') !== -1) {
          sheetOsl = allSheets[sIdx];
          break;
        }
      }
    }

    if (sheetOsl && sheetOsl.getLastRow() > 1) {
      var oslRows = sheetOsl.getDataRange().getValues();
      var colUnitKerja = 0;
      var colOslTotal = 1;

      // Cek baris pertama apakah baris header
      for (var oc = 0; oc < oslRows[0].length; oc++) {
        var oh = String(oslRows[0][oc] || '').trim().toUpperCase();
        if (oh.indexOf('UNIT') !== -1 || oh.indexOf('CABANG') !== -1) colUnitKerja = oc;
        if (oh.indexOf('OSL') !== -1 || oh.indexOf('TOTAL') !== -1) colOslTotal = oc;
      }

      for (var or2 = 1; or2 < oslRows.length; or2++) {
        var rD = oslRows[or2];
        if (!rD || rD.length === 0) continue;

        var rawName = String(rD[colUnitKerja] || '').trim();
        if (!rawName) continue;

        var oslVal = parseNum(rD[colOslTotal]);
        if (oslVal <= 0) continue;

        var upperName = rawName.toUpperCase();
        var isAreaTotal = (upperName === 'AREA GORONTALO' || upperName.indexOf('TOTAL') !== -1);

        oslData.push({
          area: 'AREA GORONTALO',
          cabang: cleanCode(rawName),
          unit: cleanCode(rawName),
          oslTotal: oslVal,
          isAreaTotal: isAreaTotal
        });
      }
    }

    var recordList = Object.keys(aggregated).map(function(k) { return aggregated[k]; });
    logAction('PublicUser', 'FETCH_DASHBOARD', 'Sinkronisasi sukses: ' + recordList.length + ' unit/produk, ' + oslData.length + ' OSL');

    return {
      success: true,
      lastUpdated: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd MMM yyyy, HH:mm:ss'),
      records: recordList,
      osl: oslData
    };
  } catch (err) {
    return { success: false, message: 'Gagal fetch data: ' + err.message };
  }
}

/**
 * Hash password (dipertahankan)
 */
function hashPassword(password) {
  var rawHash = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, password, Utilities.Charset.UTF_8);
  var output = '';
  for (var i = 0; i < rawHash.length; i++) {
    var byteValue = rawHash[i];
    if (byteValue < 0) byteValue += 256;
    var byteString = byteValue.toString(16);
    if (byteString.length == 1) byteString = '0' + byteString;
    output += byteString;
  }
  return output;
}

/**
 * Catat aktivitas ke Sheet AuditLog
 */
function logAction(username, action, details) {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName('AuditLog');
    if (sheet) sheet.appendRow([new Date(), username || 'System', action, details]);
  } catch (e) { /* abaikan */ }
}
